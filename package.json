{
  "name": "@shirhatti/cc-planner",
  "version": "1.0.0",
  "description": "Virtual File System for Claude Code Plan Mode",
  "author": "shirhatti",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run web/server.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "app:dev": "bun run build && electrobun dev",
    "app:build": "bun run build && electrobun build --env=stable",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint desktop/ preload/ scripts/ web/ vite.config.ts electrobun.config.ts",
    "lint:fix": "eslint --fix desktop/ preload/ scripts/ web/ vite.config.ts electrobun.config.ts",
    "format": "prettier --write desktop/ preload/ scripts/ web/ vite.config.ts electrobun.config.ts",
    "format:check": "prettier --check desktop/ preload/ scripts/ web/ vite.config.ts electrobun.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@assistant-ui/react": "^0.15.23",
    "@assistant-ui/react-markdown": "^0.14.18",
    "@pierre/diffs": "^1.2.9",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electrobun": "^1.18.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.55.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  }
}
